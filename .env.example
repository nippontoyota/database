# Supabase dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The "anon" key (or the newer "publishable" key). Do NOT use the service_role key here.
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# Optional: rows fetched per request while streaming a download (default 1000).
# Keep this at or below your project's "Max rows" API setting.
# EXPORT_PAGE_SIZE=1000

# Needed for /admin (creating users). Server-only — never prefix with NEXT_PUBLIC_.
# Project Settings -> API -> service_role key.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Comma-separated emails allowed to see /admin and create new users.
ADMIN_EMAILS=you@example.com

# Invite emails + mandatory TOTP (authenticator app) MFA require, in the
# Supabase dashboard (not here):
# 1. Auth -> SMTP Settings: a custom SMTP provider (the built-in sender is
#    rate-limited to a handful of emails/hour).
# 2. Auth -> URL Configuration: Site URL set to wherever this app runs.
# 3. Auth -> Email Templates -> "Invite user": point the link at this app's
#    own confirm route instead of Supabase's hosted one:
#    {{ .SiteURL }}/auth/confirm?token_hash={{ .TokenHash }}&type=invite&next=/set-password
